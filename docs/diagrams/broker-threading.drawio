<mxCell id="pin_logo" value="🚦" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="1210" width="36" height="36" as="geometry"/></mxCell>
<mxCell id="pin_text" value="&lt;b&gt;VT-pinning gate (CI-enforced):&lt;/b&gt;  &lt;b&gt;VirtualThreadPinningIT&lt;/b&gt; records &lt;code&gt;jdk.VirtualThreadPinned&lt;/code&gt; JFR events during 200 concurrent produces · asserts count == 0  ·  &lt;b&gt;VtPinningBenchScaleIT&lt;/b&gt; raises that to 2000 produces + 2000 fetches at bench scale  ·  fix is mechanical: &lt;code&gt;synchronized&lt;/code&gt; → &lt;code&gt;ReentrantLock&lt;/code&gt; on hot paths (see broker-storage/Log + LogSegment)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;whiteSpace=wrap;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="110" y="1210" width="1530" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
