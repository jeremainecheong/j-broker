        <mxCell id="driver_panel" value="Production driver  ·  raft-transport" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;align=left;spacingLeft=18;verticalAlign=top;fontSize=14;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#0f172a;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="480" height="740" as="geometry"/></mxCell>
<mxCell id="inb_box" value="Inbound (gRPC server)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="410" height="50" as="geometry"/></mxCell>
<mxCell id="inb_caption" value="RaftServiceImpl deserialises wire proto&lt;br/&gt;→ enqueues RaftEvent on driver pump" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="152" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="pump_box" value="RaftDriver pump  ·  single virtual thread" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="410" height="50" as="geometry"/></mxCell>
<mxCell id="pump_caption" value="BlockingQueue&amp;lt;PendingEvent&amp;gt;&lt;br/&gt;drains events FIFO · single source of truth" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="262" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="tick_box" value="RaftDriver ticker  ·  virtual thread" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="410" height="50" as="geometry"/></mxCell>
<mxCell id="tick_caption" value="every 30 ms · enqueues TickEvent&lt;br/&gt;drives election timeout / heartbeat cadence" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="362" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="out_box" value="Outbound (RaftPeerClient × N)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="410" height="50" as="geometry"/></mxCell>
<mxCell id="out_caption" value="Netty channels per peer · waitForReady before first RPC&lt;br/&gt;(channel.READY ≠ TCP accept — see learnings/)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="462" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="persist_panel" value="On-disk persisted state" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#0f172a;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="410" height="200" as="geometry"/></mxCell>
<mxCell id="frl_box" value="FileRaftLog" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="180" height="38" as="geometry"/></mxCell>
<mxCell id="frl_caption" value="[length][CRC32][payload]&lt;br/&gt;torn-write recovery on start" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="270" y="580" width="190" height="38" as="geometry"/></mxCell>
<mxCell id="fps_box" value="FilePersistentState" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="180" height="38" as="geometry"/></mxCell>
<mxCell id="fps_caption" value="term + votedFor (12 bytes)&lt;br/&gt;fsync before any vote reply" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="270" y="630" width="190" height="38" as="geometry"/></mxCell>
<mxCell id="snap_box" value="Snapshots" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="180" height="38" as="geometry"/></mxCell>
<mxCell id="snap_caption" value="≥10k entries · chunked InstallSnapshot&lt;br/&gt;atomic rename on completion" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="270" y="680" width="190" height="38" as="geometry"/></mxCell>
<mxCell id="core_panel" value="raft-core  ·  pure step-function" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;align=left;spacingLeft=18;verticalAlign=top;fontSize=14;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#0f172a;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="580" y="30" width="540" height="740" as="geometry"/></mxCell>
<mxCell id="step_box" value="&lt;b style='font-size:20px;'&gt;RaftCore.step(RaftEvent)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:18px;'&gt;→ List&amp;lt;RaftEffect&amp;gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=3;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#0f172a;shadow=0;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="480" height="130" as="geometry"/></mxCell>
<mxCell id="step_caption" value="&lt;b&gt;Pure&lt;/b&gt; · no I/O, no threads, no clock&lt;br/&gt;&lt;b&gt;Deterministic&lt;/b&gt; · same events → same effects&lt;br/&gt;&lt;b&gt;Total&lt;/b&gt; · every event has a defined transition" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="630" y="280" width="440" height="60" as="geometry"/></mxCell>
<mxCell id="impl_panel" value="DefaultRaftCore implements every §5 rule" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#0f172a;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="610" y="360" width="480" height="410" as="geometry"/></mxCell>
<mxCell id="r_state" value="✓  Role + Term + log + persistent (term, votedFor)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="630" y="410" width="440" height="38" as="geometry"/></mxCell>
<mxCell id="r_prevote" value="✓  Pre-vote (defends healthy leader from stale follower)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="630" y="460" width="440" height="38" as="geometry"/></mxCell>
<mxCell id="r_conflict" value="✓  Conflict-index fast backoff (§5.3 optimisation)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="630" y="510" width="440" height="38" as="geometry"/></mxCell>
<mxCell id="r_commit" value="✓  §5.4.2 commit rule — only majority-match on own term" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="630" y="560" width="440" height="38" as="geometry"/></mxCell>
<mxCell id="r_logmatch" value="✓  Log-matching property — (term, index) uniquely identifies" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="630" y="610" width="440" height="38" as="geometry"/></mxCell>
<mxCell id="r_snapshot" value="✓  InstallSnapshot — chunked, atomic rename" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="630" y="660" width="440" height="38" as="geometry"/></mxCell>
<mxCell id="r_xfer" value="✓  Leadership transfer via TimeoutNow" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="630" y="710" width="440" height="38" as="geometry"/></mxCell>
<mxCell id="sim_panel" value="Simulator  ·  simulator/" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;align=left;spacingLeft=18;verticalAlign=top;fontSize=14;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#0f172a;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1190" y="30" width="480" height="740" as="geometry"/></mxCell>
<mxCell id="seed_box" value="Seeded scenario driver" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#9333ea;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1220" y="100" width="410" height="50" as="geometry"/></mxCell>
<mxCell id="seed_caption" value="10 000 seeds per CI run · --seed N reproduces&lt;br/&gt;any failure trace exactly" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1220" y="152" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="bus_box" value="Mock event bus" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#9333ea;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1220" y="210" width="410" height="50" as="geometry"/></mxCell>
<mxCell id="bus_caption" value="in-process queue · injects message reorders /&lt;br/&gt;drops / partitions the real network can't" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1220" y="262" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="vclk_box" value="Virtual clock" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#9333ea;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1220" y="310" width="410" height="50" as="geometry"/></mxCell>
<mxCell id="vclk_caption" value="advances on demand · 10k scenarios in seconds&lt;br/&gt;instead of hours" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1220" y="362" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="mem_box" value="In-memory log + state machine" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#9333ea;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1220" y="410" width="410" height="50" as="geometry"/></mxCell>
<mxCell id="mem_caption" value="no FileRaftLog / FilePersistentState&lt;br/&gt;raft-core runs identically on either backing" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1220" y="462" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="inv_panel" value="Safety invariants checked after every step" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#a855f7;strokeWidth=2;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;fontColor=#0f172a;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1220" y="540" width="410" height="200" as="geometry"/></mxCell>
<mxCell id="i_elect" value="✓  Election safety  ·  ≤ 1 leader per term" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#0f172a;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="580" width="370" height="30" as="geometry"/></mxCell>
<mxCell id="i_logm" value="✓  Log-matching  ·  (term, index) → identical prior log" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#0f172a;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="618" width="370" height="30" as="geometry"/></mxCell>
<mxCell id="i_compl" value="✓  Leader completeness  ·  committed entries appear in every future leader" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#0f172a;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="656" width="370" height="30" as="geometry"/></mxCell>
<mxCell id="i_apply" value="✓  State-machine safety  ·  apply order matches commit order" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#0f172a;fontSize=10;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="694" width="370" height="30" as="geometry"/></mxCell>
<mxCell id="e_left_io" value="RaftEvent ↔ RaftEffect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;endArrow=classic;endFill=1;endSize=8;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#0f172a;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;startArrow=classic;startFill=1;startSize=8;exitX=1;exitY=0.18;entryX=0;entryY=0.5;" edge="1" source="driver_panel" target="step_box" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e_right_io" value="RaftEvent ↔ RaftEffect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;endArrow=classic;endFill=1;endSize=8;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#0f172a;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;startArrow=classic;startFill=1;startSize=8;exitX=0;exitY=0.18;entryX=1;entryY=0.5;" edge="1" source="sim_panel" target="step_box" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="archunit_panel" value="&lt;b&gt;🔒 ArchUnit invariant (compile-time):&lt;/b&gt;  raft-core imports zero &lt;code&gt;javax.*&lt;/code&gt;, &lt;code&gt;jakarta.*&lt;/code&gt;, &lt;code&gt;io.grpc.*&lt;/code&gt;, &lt;code&gt;org.springframework.*&lt;/code&gt;  ·  this is what makes the dual-driver design enforceable, not just aspirational" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#eab308;strokeWidth=1.5;fontColor=#451a03;fontSize=11;fontStyle=0;fontFamily=ui-sans-serif, system-ui, -apple-system, sans-serif;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="1640" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
