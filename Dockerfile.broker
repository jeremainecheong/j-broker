# syntax=docker/dockerfile:1.7
#
# Broker runtime image. Two-stage build:
#   1. JDK builder runs `:broker-app:installDist` (skips tests) to produce a
#      self-contained distribution under broker-app/build/install/broker-app/
#      with a launcher script at bin/broker-app.
#   2. JRE runtime copies just that distribution in — no gradle, no sources,
#      no test classes.

# Base images pinned by digest (2026-04-23) so two builds a month apart
# can't drift. Temurin publishes fresh digests for the same floating tag
# periodically — re-pin when we pull in a deliberate update.
FROM eclipse-temurin:21-jdk@sha256:e58e492628c1428ceb838afc1a1b8762673d5eaa09296f560c363daea0fdcf3b AS builder
WORKDIR /src

COPY . .
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew :broker-app:installDist -x test --no-daemon

FROM eclipse-temurin:21-jre@sha256:ff65ff0d43c73d2b675eb4b758665a5cb487e7df127436a9979f8172c144c819
LABEL org.opencontainers.image.title="j-broker"
LABEL org.opencontainers.image.description="Educational Kafka-shaped log broker"
LABEL org.opencontainers.image.source="https://github.com/jeremainecheong/j-broker"

WORKDIR /opt/jbroker
COPY --from=builder /src/broker-app/build/install/broker-app/ /opt/jbroker/

# Non-root runtime: the broker never needs privileged capabilities. Host
# bind-mounts onto /var/lib/jbroker need to be chown'd to uid 1001 or have
# world-writable perms; named volumes inherit this directive's owner.
RUN groupadd --system --gid 1001 jbroker \
    && useradd --system --uid 1001 --gid jbroker --home-dir /opt/jbroker --shell /usr/sbin/nologin jbroker \
    && mkdir -p /var/lib/jbroker \
    && chown -R jbroker:jbroker /opt/jbroker /var/lib/jbroker
VOLUME /var/lib/jbroker

# 9092 — broker gRPC (producer/consumer/admin/metadata services)
# 9192 — Raft peer RPC
# 9100 — optional chaos HTTP control plane (only bound when --chaos-port ≥ 0)
EXPOSE 9092 9192 9100

USER jbroker

# HEALTHCHECK — bash TCP probe against the broker gRPC port. eclipse-temurin
# ships bash by default; `3<>/dev/tcp/host/port` returns non-zero when the
# broker isn't accepting connections (not-yet-bound, paused by chaos, or
# carrier-thread deadlock). 10s start-period covers the cold-start window
# where Raft is still holding an election.
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
    CMD bash -c 'exec 3<>/dev/tcp/localhost/9092' || exit 1

ENTRYPOINT ["/opt/jbroker/bin/broker-app"]
# Default command: single-broker server on the conventional ports. The
# compose file overrides this to pass --voters + --id + --chaos-port for the
# 3-broker cluster layout.
CMD ["server", "--data-dir", "/var/lib/jbroker"]
