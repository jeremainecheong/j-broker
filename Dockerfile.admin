# syntax=docker/dockerfile:1.7
#
# Admin UI runtime image. Spring Boot bootJar is self-contained, so
# the runtime layer is just `java -jar admin-app.jar`.

# Base images pinned by digest (2026-04-23) — re-pin when we pull in a
# deliberate update. Keeps two builds a month apart byte-identical in
# the base layers.
FROM eclipse-temurin:21-jdk@sha256:e58e492628c1428ceb838afc1a1b8762673d5eaa09296f560c363daea0fdcf3b AS builder
WORKDIR /src

COPY . .
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew :admin-app:bootJar -x test --no-daemon

FROM eclipse-temurin:21-jre@sha256:ff65ff0d43c73d2b675eb4b758665a5cb487e7df127436a9979f8172c144c819
LABEL org.opencontainers.image.title="j-broker-admin"
LABEL org.opencontainers.image.description="j-broker management UI (Thymeleaf + htmx)"
LABEL org.opencontainers.image.source="https://github.com/jeremainecheong/j-broker"

WORKDIR /opt/jbroker
COPY --from=builder /src/admin-app/build/libs/admin-app.jar /opt/jbroker/admin-app.jar

# Non-root runtime. Admin-app is a read-mostly REST/Thymeleaf frontend
# against the broker cluster — no persistent data dir needed.
RUN groupadd --system --gid 1001 jbroker \
    && useradd --system --uid 1001 --gid jbroker --home-dir /opt/jbroker --shell /usr/sbin/nologin jbroker \
    && chown -R jbroker:jbroker /opt/jbroker

# RabbitMQ's management plugin listens on 15672 — we adopt the same port so
# people looking for "the management UI" find it on the port they expect.
ENV SERVER_PORT=15672
EXPOSE 15672

USER jbroker

# HEALTHCHECK — bash TCP probe on the Spring Boot HTTP port. A deeper
# check would hit /actuator/health, but curl/wget aren't in the base
# image and a full TCP accept is enough to know the JVM is alive and
# Tomcat has bound the port.
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
    CMD bash -c 'exec 3<>/dev/tcp/localhost/15672' || exit 1

ENTRYPOINT ["java", "-jar", "/opt/jbroker/admin-app.jar"]
